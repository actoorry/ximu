<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.by</groupId>
        <artifactId>ximu</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ximu-common-web</artifactId>
    <name>ximu-common-web</name>
    <description>公共 Web 模块：servlet 基础设施收敛（身份过滤器/跨域/全局异常/审计填充/MyBatis-Plus 配置/操作日志），
        inventory 与 safe-stock 两 servlet 服务共享，避免跨服务复制粘贴</description>

    <dependencies>
        <!-- 公共库：Result/PageQuery/OperatorContext/Auths/Role 等 -->
        <dependency>
            <groupId>com.by</groupId>
            <artifactId>ximu-common</artifactId>
        </dependency>
        <!-- servlet 基础设施：OperatorContextFilter/CorsConfig/GlobalExceptionHandler 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- MyBatis-Plus：MybatisPlusConfig 注册拦截器（extension 提供 interceptor，
             core 提供 BaseMapper/实体注解，jsqlparser 供 PaginationInnerInterceptor；
             IService/ServiceImpl 自 3.5.9 起拆至 mybatis-plus-spring，本模块直接依赖 extension 必须显式引入），
             版本由根 pom 统一管理 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- spring-tx：org.springframework.dao（DataIntegrityViolationException/DuplicateKeyException）
             供 GlobalExceptionHandler 使用；mybatis-plus-spring 中 spring-jdbc 为 optional 不传递，须显式声明 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
